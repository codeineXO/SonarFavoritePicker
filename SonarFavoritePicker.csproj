<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Desktop already references Core; naming Desktop here makes the native
         missing-runtime prompt offer the complete Desktop Runtime installer. -->
    <AlwaysIncludeCoreFrameworkInRuntimeConfig>false</AlwaysIncludeCoreFrameworkInRuntimeConfig>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\sonar.ico</ApplicationIcon>
    <AssemblyName>SonarFavoritePicker</AssemblyName>
    <Version>1.0.0</Version>
    <RepositoryUrl>https://github.com/codeineXO/SonarFavoritePicker</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="assets\sonar.ico" LogicalName="SonarFavoritePicker.sonar.ico" />
  </ItemGroup>
</Project>
